<UserControl x:Class="WPF_GUI.Controls.FoldableEventList"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="420">
    <ListView x:Name="EventsView"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ItemsSource="{Binding ItemsSource, ElementName=root}">
        <ListView.View>
            <GridView>
                <GridViewColumn x:Name="EventColumn"
                                Width="100"
                                DisplayMemberBinding="{Binding eventdata}">
                    <GridViewColumn.HeaderContainerStyle>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </GridViewColumn.HeaderContainerStyle>
                    <GridViewColumn.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Event"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      x:Name="ShowDetailsCheckBox"
                                      Width="16"
                                      Height="16"
                                      Margin="4,0,0,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      ToolTip="Show details"
                                      AutomationProperties.Name="Show details"
                                      IsChecked="{Binding IsExpanded, ElementName=root, Mode=TwoWay}" />
                        </Grid>
                    </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn x:Name="DetailColumn"
                                Header="Detail"
                                Width="0">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding detailmessage}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
