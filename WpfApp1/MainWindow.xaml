<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="AsyncElastic (WPF)" Height="554" Width="1201"
        MinHeight="400" MinWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="FilterGrid"
                  Grid.Row="0"
                  ItemsSource="{Binding FilterRules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  KeyDown="FilterGrid_KeyDown">
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#33007ACC" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="OrangeRed" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Remove selected" Click="RemoveSelected_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Del"
                                    Padding="6,0"
                                    Click="RemoveRule_Click"
                                    Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="ServiceName"
                                    Binding="{Binding ServiceNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" CanUserSort="False" />
                <DataGridTextColumn Header="ClassName"
                                    Binding="{Binding ClassNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" CanUserSort="False" />
                <DataGridTextColumn Header="MethodName"
                                    Binding="{Binding MethodNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" CanUserSort="False" />
                <DataGridTextColumn Header="Message"
                                    Binding="{Binding MessagePattern, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" CanUserSort="False" />

                <DataGridTemplateColumn Header="Color" Width="84" CanUserSort="False" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding MatchColorHex}"
                                    Background="{Binding MatchBrush}"
                                    Foreground="{Binding MatchForeground}"
                                    Padding="6,0"
                                    Click="PickColor_Click"
                                    Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ListView x:Name="LogList"
                  Grid.Row="1"
                  ItemsSource="{Binding LogEntries}"
                  BorderThickness="1"
                  Margin="0,6,0,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Background" Value="{Binding Background}" />
                    <Setter Property="Foreground" Value="{Binding Foreground}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="2,1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="#FF3399FF" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="OrangeRed" />
                            <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ServiceName" DisplayMemberBinding="{Binding ServiceName}" Width="160" />
                    <GridViewColumn Header="ClassName" DisplayMemberBinding="{Binding ClassName}" Width="240" />
                    <GridViewColumn Header="MethodName" DisplayMemberBinding="{Binding MethodName}" Width="200" />
                    <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="520" />
                </GridView>
            </ListView.View>
        </ListView>

        <Button x:Name="ApplyButton"
                Grid.Row="2"
                Content="Apply colors"
                Width="120"
                Height="29"
                HorizontalAlignment="Left"
                Margin="0,6,0,0"
                Click="ApplyButton_Click" />
    </Grid>
</Window>
